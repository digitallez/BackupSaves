## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/

# Visual Studio
.vs/
**/.vs/
**/.vs/**
*.VC.db
*.VC.VC.opendb
*.pidb
*.svclog
*.pdb
*.ilk
*.meta
*.obj
*.iobj
*.pch
*.pgc
*.pgd
*.rsp
*.sbr
*.tlb
*.tli
*.tlh
*.tmp
*.tmp_proj
*_wpftmp.csproj
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc

# MSTest / NUnit / cover
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.coverage
*.coveragexml
coverage*.json
coverage*.xml
TestResult.xml

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json

# Publish / clickonce
publish/
*.publishsettings
*.azurePubxml
*.pubxml
*.pubxml.user

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# JetBrains
.idea/
*.sln.iml

# VS Code (keep shared settings if added later)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example

# Cursor — keep project rules, ignore local/cache
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# OS / misc
*.swp
*~
.DS_Store

# App local data (never commit real settings/logs)
**/settings.json.tmp
*.restore.tmp

# Regenerable icon intermediates (keep Assets/app.ico)
WpfApp_BackupSaves/WpfApp_BackupSaves/Assets/icon-png/

# lean-ctx local cache
**/.lean-ctx/
