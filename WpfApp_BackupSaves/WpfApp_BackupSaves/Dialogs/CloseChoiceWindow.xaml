<Window x:Class="WpfApp_BackupSaves.Dialogs.CloseChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WpfApp_BackupSaves.Controls"
        Title="Закрытие BackupSaves"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
  <DockPanel>
    <controls:CustomTitleBar DockPanel.Dock="Top" ShowMaximize="False"/>

    <StackPanel Margin="20">
      <TextBlock Text="Что сделать с приложением?"
                 FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"
                 TextWrapping="Wrap"/>
      <TextBlock Text="Можно скрыть в трей и продолжить фоновую работу, либо полностью выйти."
                 Foreground="{DynamicResource SecondaryTextBrush}"
                 TextWrapping="Wrap" Margin="0,0,0,20"/>

      <Button Content="Скрыть в трей" Height="36" Margin="0,0,0,8"
              Click="Tray_Click" IsDefault="True"/>
      <Button Content="Выйти из приложения" Height="36" Margin="0,0,0,8"
              Click="Exit_Click"/>
      <Button Content="Отмена" Height="36"
              Click="Cancel_Click" IsCancel="True"/>
    </StackPanel>
  </DockPanel>
</Window>
