<Window x:Class="WpfApp_BackupSaves.Dialogs.AppMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WpfApp_BackupSaves.Controls"
        Title="BackupSaves"
        Width="440" MinWidth="360" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
  <DockPanel>
    <controls:CustomTitleBar x:Name="TitleBar" DockPanel.Dock="Top" ShowMaximize="False"/>

    <StackPanel Margin="20">
      <Grid Margin="0,0,0,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="IconBlock"
                   Grid.Column="0"
                   FontFamily="Segoe MDL2 Assets"
                   FontSize="28"
                   VerticalAlignment="Top"
                   Margin="0,0,14,0"
                   Visibility="Collapsed"/>
        <TextBlock x:Name="MessageBlock"
                   Grid.Column="1"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   FontSize="13"/>
      </Grid>

      <StackPanel x:Name="ButtonsPanel"
                  Orientation="Horizontal"
                  HorizontalAlignment="Right"/>
    </StackPanel>
  </DockPanel>
</Window>
