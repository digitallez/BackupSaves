<Window x:Class="WpfApp_BackupSaves.Dialogs.ProfileEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WpfApp_BackupSaves.Controls"
        Title="Профиль бэкапа" Height="560" Width="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
  <DockPanel>
    <controls:CustomTitleBar DockPanel.Dock="Top" ShowMaximize="True"/>

    <DockPanel Margin="16">
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
        <Button Content="Сохранить" Width="110" Height="32" Margin="0,0,8,0" IsDefault="True" Click="Save_Click"/>
        <Button Content="Отмена" Width="110" Height="32" IsCancel="True" Click="Cancel_Click"/>
      </StackPanel>

      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <TextBlock Text="Имя" VerticalAlignment="Center"/>
          <TextBox x:Name="NameBox" Grid.Column="1" Margin="0,4" Height="28"/>

          <TextBlock Text="BackupRoot" Grid.Row="1" VerticalAlignment="Center"/>
          <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,4">
            <Button DockPanel.Dock="Right" Content="…" Width="36" Height="28" Margin="6,0,0,0" Click="BrowseRoot_Click"/>
            <TextBox x:Name="RootBox" Height="28"/>
          </DockPanel>

          <TextBlock Text="Формат" Grid.Row="2" VerticalAlignment="Center"/>
          <ComboBox x:Name="FormatBox" Grid.Row="2" Grid.Column="1" Margin="0,4" Height="28"
                    SelectedIndex="0">
            <ComboBoxItem Content="7z (рекомендуется)" Tag="SevenZip"/>
            <ComboBoxItem Content="ZIP (запасной)" Tag="Zip"/>
          </ComboBox>

          <TextBlock Text="Retention N" Grid.Row="3" VerticalAlignment="Center"/>
          <TextBox x:Name="RetentionBox" Grid.Row="3" Grid.Column="1" Margin="0,4" Height="28" Text="10"/>

          <TextBlock Text="Расписание" Grid.Row="4" VerticalAlignment="Center"/>
          <StackPanel Grid.Row="4" Grid.Column="1" Margin="0,4">
            <CheckBox x:Name="ScheduleEnabled" Content="Включить Task Scheduler" Margin="0,0,0,6"/>
            <DockPanel>
              <ComboBox x:Name="ScheduleKindBox" Width="140" Height="28" SelectedIndex="0">
                <ComboBoxItem Content="Daily" Tag="Daily"/>
                <ComboBoxItem Content="Weekly" Tag="Weekly"/>
                <ComboBoxItem Content="OnLogon" Tag="OnLogon"/>
                <ComboBoxItem Content="Interval" Tag="Interval"/>
              </ComboBox>
              <TextBlock Text="Время" VerticalAlignment="Center" Margin="12,0,6,0"/>
              <TextBox x:Name="TimeBox" Width="70" Height="28" Text="02:00"/>
              <TextBlock Text="Интервал мин" VerticalAlignment="Center" Margin="12,0,6,0"/>
              <TextBox x:Name="IntervalBox" Width="60" Height="28" Text="60"/>
            </DockPanel>
          </StackPanel>

          <TextBlock Text="Источники" Grid.Row="5" Margin="0,12,0,4" FontWeight="SemiBold" Grid.ColumnSpan="2"/>

          <DockPanel Grid.Row="6" Grid.ColumnSpan="2" Margin="0,0,0,6">
            <Button DockPanel.Dock="Right" Content="Файл…" Width="80" Height="28" Margin="6,0,0,0" Click="AddFile_Click"/>
            <Button DockPanel.Dock="Right" Content="Папка…" Width="80" Height="28" Click="AddFolder_Click"/>
            <Button DockPanel.Dock="Right" Content="Удалить" Width="80" Height="28" Margin="0,0,6,0" Click="RemoveSource_Click"/>
            <TextBlock Text="Файлы и папки для бэкапа" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
          </DockPanel>

          <ListBox x:Name="SourcesList" Grid.Row="7" Grid.ColumnSpan="2" MinHeight="140"
                   DisplayMemberPath="Path"/>
        </Grid>
      </ScrollViewer>
    </DockPanel>
  </DockPanel>
</Window>
