<Window x:Class="WpfApp_BackupSaves.Dialogs.FirstRunInstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WpfApp_BackupSaves.Controls"
        xmlns:loc="clr-namespace:WpfApp_BackupSaves.Markup"
        Title="{loc:Loc install.firstTitle}"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
  <DockPanel>
    <controls:CustomTitleBar DockPanel.Dock="Top" ShowMaximize="False"/>

    <StackPanel Margin="20">
      <TextBlock Text="{loc:Loc install.firstQuestion}"
                 FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"
                 TextWrapping="Wrap"/>
      <TextBlock x:Name="PathHintBlock"
                 Foreground="{DynamicResource SecondaryTextBrush}"
                 TextWrapping="Wrap" Margin="0,0,0,20"/>

      <Button Content="{loc:Loc install.installRecommended}" Height="36" Margin="0,0,0,8"
              Click="Install_Click" IsDefault="True"
              ToolTip="{loc:Loc install.installTip}"/>
      <Button Content="{loc:Loc install.useCurrent}" Height="36"
              Click="UseCurrent_Click" IsCancel="True"
              ToolTip="{loc:Loc install.useCurrentTip}"/>
    </StackPanel>
  </DockPanel>
</Window>
