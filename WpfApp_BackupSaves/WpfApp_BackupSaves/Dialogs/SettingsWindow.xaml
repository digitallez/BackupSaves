<Window x:Class="WpfApp_BackupSaves.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WpfApp_BackupSaves.Controls"
        xmlns:loc="clr-namespace:WpfApp_BackupSaves.Markup"
        Title="{loc:Loc settings.title}"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
  <DockPanel>
    <controls:CustomTitleBar DockPanel.Dock="Top" ShowMaximize="False"/>

    <StackPanel Margin="20">
      <TextBlock Text="{loc:Loc settings.theme}" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <ComboBox x:Name="ThemeCombo" Height="30" Margin="0,0,0,14"
                SelectionChanged="ThemeCombo_SelectionChanged">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Text="{loc:Loc settings.language}" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <ComboBox x:Name="LanguageCombo" Height="30" Margin="0,0,0,14"
                SelectionChanged="LanguageCombo_SelectionChanged">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Image Width="16" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                     RenderOptions.BitmapScalingMode="HighQuality"
                     Source="{Binding FlagUri}" Margin="0,0,6,0">
                <Image.Style>
                  <Style TargetType="Image">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasFlag}" Value="False">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Margin" Value="0"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Image.Style>
              </Image>
              <TextBlock Text="{Binding Display}" VerticalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <TextBlock Text="{loc:Loc settings.closeAction}" FontWeight="SemiBold" Margin="0,0,0,6"
                 ToolTip="{loc:Loc settings.closeActionTip}"/>
      <ComboBox x:Name="CloseActionCombo" Height="30" Margin="0,0,0,18"
                SelectionChanged="CloseActionCombo_SelectionChanged"
                ToolTip="{loc:Loc settings.closeActionTip}">
        <ComboBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets" FontSize="14"
                         VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
            </StackPanel>
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>

      <Button Height="34" Margin="0,0,0,8" Click="Logs_Click"
              ToolTip="{loc:Loc main.logsTooltip}">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="{loc:Loc settings.openLogsFolder}" VerticalAlignment="Center"/>
        </StackPanel>
      </Button>
      <StackPanel Margin="0,0,0,8">
        <DockPanel LastChildFill="True">
          <TextBlock DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0">
            <Hyperlink Click="GitHubReleases_Click"
                       ToolTip="{loc:Loc settings.githubReleasesTip}">
              <Run Text="{loc:Loc settings.githubReleases}"/>
            </Hyperlink>
          </TextBlock>
          <CheckBox x:Name="CheckUpdatesAutoBox"
                    Content="{loc:Loc settings.checkUpdatesAuto}"
                    ToolTip="{loc:Loc settings.checkUpdatesAutoTip}"
                    VerticalAlignment="Center"
                    Checked="CheckUpdatesAuto_Changed"
                    Unchecked="CheckUpdatesAuto_Changed"/>
        </DockPanel>
        <TextBlock Text="{loc:Loc settings.checkUpdatesAutoTip}" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="18,4,0,8"/>
        <Button Height="34" Click="CheckUpdates_Click"
                ToolTip="{loc:Loc settings.checkUpdatesTip}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock Text="{loc:Loc settings.checkUpdates}" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </StackPanel>
      <StackPanel Margin="0,0,0,14">
        <Button x:Name="InstallButton" Height="34" Click="Install_Click"
                ToolTip="{loc:Loc settings.installTip}"
                HorizontalContentAlignment="Left">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="InstallButtonText" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <TextBlock Text="{loc:Loc settings.installTip}" FontSize="11" TextWrapping="Wrap"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   Margin="2,4,0,0"/>
      </StackPanel>

      <StackPanel x:Name="DevFolderPanel" Visibility="Collapsed" Margin="0,0,0,14">
        <TextBlock Text="{loc:Loc settings.devFolder}" FontWeight="SemiBold" Margin="0,0,0,6"
                   ToolTip="{loc:Loc settings.devFolderTip}"/>
        <DockPanel Margin="0,0,0,0"
                   ToolTip="{loc:Loc settings.devFolderTip}">
          <Button DockPanel.Dock="Right" MinWidth="88" Height="30" Margin="8,0,0,0"
                  Content="{loc:Loc settings.devFolderBrowse}"
                  Click="DevFolderBrowse_Click"
                  ToolTip="{loc:Loc settings.devFolderTip}"/>
          <TextBox x:Name="DevFolderBox" Height="30" VerticalContentAlignment="Center"
                   LostFocus="DevFolderBox_LostFocus"/>
        </DockPanel>
      </StackPanel>

      <Button Content="{loc:Loc common.ok}" Height="34" HorizontalAlignment="Right"
              MinWidth="100" Click="Ok_Click" IsDefault="True" IsCancel="True"/>
    </StackPanel>
  </DockPanel>
</Window>
