<Window x:Class="WpfApp_BackupSaves.Dialogs.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WpfApp_BackupSaves.Controls"
        Title="Обновление BackupSaves"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
  <DockPanel>
    <controls:CustomTitleBar DockPanel.Dock="Top" ShowMaximize="False"/>

    <StackPanel Margin="20">
      <TextBlock x:Name="TitleBlock" FontSize="15" FontWeight="SemiBold"
                 TextWrapping="Wrap" Margin="0,0,0,8"/>
      <TextBlock x:Name="BodyBlock"
                 Foreground="{DynamicResource SecondaryTextBrush}"
                 TextWrapping="Wrap" Margin="0,0,0,16"/>

      <Button Content="Обновить сейчас" Height="36" Margin="0,0,0,8"
              Click="Now_Click" IsDefault="True"
              ToolTip="Скачать, установить и перезапустить приложение"/>
      <Button Content="Обновить при закрытии" Height="36" Margin="0,0,0,8"
              Click="OnClose_Click"
              ToolTip="Скачать заранее; установить при выходе из приложения (без автозапуска)"/>
      <Button Content="Не обновлять на эту версию" Height="36" Margin="0,0,0,8"
              Click="Skip_Click"
              ToolTip="Больше не предлагать именно эту версию"/>
      <Button Content="Спросить позже" Height="36"
              Click="Later_Click" IsCancel="True"/>
    </StackPanel>
  </DockPanel>
</Window>
