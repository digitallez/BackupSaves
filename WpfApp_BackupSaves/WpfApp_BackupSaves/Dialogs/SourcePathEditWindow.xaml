<Window x:Class="WpfApp_BackupSaves.Dialogs.SourcePathEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WpfApp_BackupSaves.Controls"
        xmlns:loc="clr-namespace:WpfApp_BackupSaves.Markup"
        Title="{loc:Loc profile.editPathTitle}"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}">
  <DockPanel>
    <controls:CustomTitleBar DockPanel.Dock="Top" ShowMaximize="False"/>

    <StackPanel Margin="20">
      <TextBlock Text="{loc:Loc profile.editPathTitle}"
                 FontSize="15" FontWeight="SemiBold" Margin="0,0,0,6"/>
      <TextBlock Text="{loc:Loc profile.editPathHint}"
                 Foreground="{DynamicResource SecondaryTextBrush}"
                 TextWrapping="Wrap" Margin="0,0,0,12"/>
      <TextBox x:Name="PathBox" Height="28" Margin="0,0,0,16"
               VerticalContentAlignment="Center"
               AcceptsReturn="False"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="{loc:Loc common.save}" Width="110" Height="32" Margin="0,0,8,0"
                IsDefault="True" Click="Ok_Click"/>
        <Button Content="{loc:Loc common.cancel}" Width="110" Height="32"
                IsCancel="True" Click="Cancel_Click"/>
      </StackPanel>
    </StackPanel>
  </DockPanel>
</Window>
