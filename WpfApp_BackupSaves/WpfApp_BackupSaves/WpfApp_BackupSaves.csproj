<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="Version.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>BackupSaves</AssemblyName>
    <TargetFramework>net9.0-windows10.0.17763.0</TargetFramework>
    <!-- WPF only — don't copy Microsoft.Windows.SDK.NET.dll / WinRT.Runtime.dll -->
    <IncludeWindowsSDKRefFrameworkReferences>false</IncludeWindowsSDKRefFrameworkReferences>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <!-- No NuGet satellite folders (TaskScheduler etc.); invariant strings stay in the main DLL -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>

    <Version>$(VersionMajor).$(VersionMinor).$(VersionPatch)</Version>
    <AssemblyVersion>$(VersionMajor).$(VersionMinor).$(VersionPatch).0</AssemblyVersion>
    <FileVersion>$(VersionMajor).$(VersionMinor).$(VersionPatch).0</FileVersion>
    <InformationalVersion>$(VersionMajor).$(VersionMinor).$(VersionPatch)</InformationalVersion>
    <Product>BackupSaves</Product>
  </PropertyGroup>

    <!-- Debug: same base number, -debug + build stamp yyMMddHHmmss (set in StampDebugVersion) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <InformationalVersion>$(VersionMajor).$(VersionMinor).$(VersionPatch)-debug</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BackupSaves.Core\BackupSaves.Core.csproj" />
    <ProjectReference Include="..\BackupSaves.Scheduler\BackupSaves.Scheduler.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\Flags\ru.png" />
    <Resource Include="Assets\Flags\us.png" />
  </ItemGroup>

  <!-- Locales JSON (+ optional .png flags) copied next to the exe -->
  <ItemGroup>
    <Content Include="Locales\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Debug: stamp InformationalVersion with build time (yyMMddHHmmss) on every build -->
  <Target Name="StampDebugVersion"
          BeforeTargets="GenerateAssemblyInfo;CoreGenerateAssemblyInfo;BeforeBuild"
          Condition="'$(Configuration)' == 'Debug' AND '$(DesignTimeBuild)' != 'true' AND !$(MSBuildProjectName.Contains('wpftmp'))">
    <PropertyGroup>
      <_BuildStamp>$([System.DateTime]::Now.ToString("yyMMddHHmmss"))</_BuildStamp>
      <InformationalVersion>$(VersionMajor).$(VersionMinor).$(VersionPatch)-debug-$(_BuildStamp)</InformationalVersion>
    </PropertyGroup>
    <Message Importance="high" Text="BackupSaves Debug version → $(InformationalVersion)" />
  </Target>

  <!-- Bump patch only on Release builds (skip Debug, design-time, WPF _wpftmp) -->
  <Target Name="IncrementVersionPatch"
          BeforeTargets="GenerateAssemblyInfo;CoreGenerateAssemblyInfo;BeforeBuild"
          Condition="'$(Configuration)' == 'Release' AND '$(DesignTimeBuild)' != 'true' AND '$(NoVersionIncrement)' != 'true' AND !$(MSBuildProjectName.Contains('wpftmp'))">
    <PropertyGroup>
      <VersionPatch>$([MSBuild]::Add($(VersionPatch), 1))</VersionPatch>
      <Version>$(VersionMajor).$(VersionMinor).$(VersionPatch)</Version>
      <AssemblyVersion>$(VersionMajor).$(VersionMinor).$(VersionPatch).0</AssemblyVersion>
      <FileVersion>$(VersionMajor).$(VersionMinor).$(VersionPatch).0</FileVersion>
      <InformationalVersion>$(VersionMajor).$(VersionMinor).$(VersionPatch)</InformationalVersion>
      <_VersionPropsContent><![CDATA[<Project>
  <PropertyGroup>
    <VersionMajor>$(VersionMajor)</VersionMajor>
    <VersionMinor>$(VersionMinor)</VersionMinor>
    <!-- Bumped only on Release builds (→ 1.0.1, 1.0.2, ...) -->
    <VersionPatch>$(VersionPatch)</VersionPatch>
  </PropertyGroup>
</Project>
]]></_VersionPropsContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(MSBuildProjectDirectory)\Version.props"
                      Lines="$(_VersionPropsContent)"
                      Overwrite="true"
                      Encoding="UTF-8" />
    <Message Importance="high" Text="BackupSaves Release version → $(InformationalVersion)" />
  </Target>

</Project>
