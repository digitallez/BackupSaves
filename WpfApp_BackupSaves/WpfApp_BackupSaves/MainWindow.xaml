<Window x:Class="WpfApp_BackupSaves.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WpfApp_BackupSaves.Controls"
        xmlns:loc="clr-namespace:WpfApp_BackupSaves.Markup"
        xmlns:vm="clr-namespace:WpfApp_BackupSaves.ViewModels"
        xmlns:models="clr-namespace:BackupSaves.Core.Models;assembly=BackupSaves.Core"
         Title="BackupSaves" Height="740" Width="1110"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
  <Window.Resources>
    <Style x:Key="SplitPartButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}"
                    CornerRadius="2,0,0,2">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
              </Trigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                  <Condition Binding="{Binding BackupUnconditional}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BackupForceHoverBrush}"/>
              </MultiDataTrigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="SplitDropButtonStyle" TargetType="ToggleButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource ControlForegroundBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    CornerRadius="0,2,2,0">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
              </Trigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                  <Condition Binding="{Binding BackupUnconditional}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BackupForceHoverBrush}"/>
              </MultiDataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True"/>
                  <Condition Binding="{Binding BackupUnconditional}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BackupForceHoverBrush}"/>
              </MultiDataTrigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MenuLikeButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <controls:CustomTitleBar DockPanel.Dock="Top"/>

    <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource StatusBarBackgroundBrush}">
      <StatusBar.ItemsPanel>
        <ItemsPanelTemplate>
          <DockPanel LastChildFill="True"/>
        </ItemsPanelTemplate>
      </StatusBar.ItemsPanel>
      <StatusBarItem>
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource PrimaryTextBrush}"/>
      </StatusBarItem>
    </StatusBar>

    <Grid Margin="12" MouseLeftButtonDown="MainContent_MouseLeftButtonDown">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="255"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition x:Name="HistorySpacerColumn" Width="12"/>
        <ColumnDefinition x:Name="HistoryColumn" Width="255"/>
      </Grid.ColumnDefinitions>

      <!-- Profiles -->
      <DockPanel Grid.Column="0">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Width="28" Height="24" Padding="0" MinWidth="0" MinHeight="0" Margin="0,0,4,0"
                    Click="AddProfile_Click" IsEnabled="{Binding CanInteract}"
                    ToolTip="{loc:Loc main.add}">
              <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <Button Width="28" Height="24" Padding="0" MinWidth="0" MinHeight="0" Margin="0,0,4,0"
                    Click="EditProfile_Click" IsEnabled="{Binding HasProfile}"
                    ToolTip="{loc:Loc main.edit}">
              <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <Button Width="28" Height="24" Padding="0" MinWidth="0" MinHeight="0"
                    Click="DeleteProfile_Click" IsEnabled="{Binding HasProfile}"
                    ToolTip="{loc:Loc main.delete}">
              <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="{loc:Loc main.profiles}" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <Border x:Name="ProfilesFilterHost"
                    Margin="8,3,0,0" Padding="2,0"
                    VerticalAlignment="Center" Cursor="Hand"
                    Background="Transparent"
                    ToolTip="{loc:Loc main.profilesFilterTip}"
                    MouseLeftButtonDown="ProfilesFilter_MouseLeftButtonDown"
                    MouseMove="ProfilesFilter_MouseMove"
                    MouseLeftButtonUp="ProfilesFilter_MouseLeftButtonUp"
                    LostMouseCapture="ProfilesFilter_LostMouseCapture">
              <Grid>
                <TextBlock Text="{loc:Loc main.profilesFilterAll}"
                           FontSize="12" FontWeight="Normal">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowAllProfiles}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=ProfilesFilterHost}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                          <Setter Property="TextDecorations" Value="Underline"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{loc:Loc main.profilesFilterActive}"
                           FontSize="12" FontWeight="Normal">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowOnlyActiveProfiles}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsMouseOver, ElementName=ProfilesFilterHost}" Value="True">
                          <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                          <Setter Property="TextDecorations" Value="Underline"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
            </Border>
          </StackPanel>
        </DockPanel>
         <ListBox x:Name="ProfilesList"
                  ItemsSource="{Binding Profiles}"
                  SelectedItem="{Binding SelectedProfile}"
                  SelectionChanged="Profiles_SelectionChanged"
                  MouseDoubleClick="ProfilesList_MouseDoubleClick"
                  PreviewMouseRightButtonDown="ProfilesList_PreviewMouseRightButtonDown">
          <ListBox.ContextMenu>
            <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                         Opened="ProfilesContextMenu_Opened">
              <MenuItem Header="{loc:Loc main.add}" Click="AddProfile_Click"
                        IsEnabled="{Binding CanInteract}"/>
              <MenuItem Header="{loc:Loc main.edit}" Click="EditProfile_Click"
                        IsEnabled="{Binding HasProfile}"/>
              <MenuItem Header="{loc:Loc main.delete}" Click="DeleteProfile_Click"
                        IsEnabled="{Binding HasProfile}"/>
              <MenuItem Header="{loc:Loc main.toggleProfileEnabled}"
                        Tag="toggleEnabled"
                        Click="ToggleProfileEnabled_Click"
                        IsEnabled="{Binding HasProfile}"/>
              <Separator/>
              <MenuItem Header="{loc:Loc main.backupNow}" Click="BackupNow_Click"
                        IsEnabled="{Binding HasProfile}" FontWeight="SemiBold"/>
              <MenuItem Header="{loc:Loc main.openFolder}" Click="OpenFolder_Click"
                        IsEnabled="{Binding HasProfile}"/>
              <MenuItem Header="{loc:Loc main.filterHistory}" Click="FilterHistoryByProfile_Click"
                        IsEnabled="{Binding HasProfile}"/>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border BorderThickness="3,0,0,0" Padding="6,2,0,2">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsWatchProcessRunning}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource ProcessRunningBrush}"/>
                        <Setter Property="Background" Value="{DynamicResource ProcessRunningBackgroundBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid Grid.Column="0" Width="20" Height="20" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Grid.Style>
                      <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasLaunchCommand}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Grid.Style>
                    <Image Width="20" Height="20" Source="{Binding LaunchIcon}"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality">
                      <Image.Style>
                        <Style TargetType="Image">
                          <Setter Property="Visibility" Value="Visible"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding LaunchIcon}" Value="{x:Null}">
                              <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Image.Style>
                    </Image>
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding LaunchIcon}" Value="{x:Null}">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding NextBackupDisplay}" FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNextBackupDisplay}" Value="True">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,2,0"
                              VerticalAlignment="Center">
                    <StackPanel.Style>
                      <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasLaunchCommand}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding IsBackingUp}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </StackPanel.Style>
                    <!-- Spinning indicator while this profile creates an archive -->
                    <Grid Width="18" Height="18" VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5"
                          ToolTip="{Binding DataContext.BackupProgressTip, RelativeSource={RelativeSource AncestorType=Window}}">
                      <Grid.Style>
                        <Style TargetType="Grid">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBackingUp}" Value="True">
                              <Setter Property="Visibility" Value="Visible"/>
                              <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="ProfileBackupSpin">
                                  <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation
                                        Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                        From="0" To="360" Duration="0:0:0.75"/>
                                  </Storyboard>
                                </BeginStoryboard>
                              </DataTrigger.EnterActions>
                              <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="ProfileBackupSpin"/>
                              </DataTrigger.ExitActions>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Grid.Style>
                      <Grid.RenderTransform>
                        <RotateTransform/>
                      </Grid.RenderTransform>
                      <Path Width="14" Height="14" Stretch="Uniform"
                            Stroke="{DynamicResource ArchiveAgeCoolBrush}"
                            StrokeThickness="2"
                            StrokeStartLineCap="Round"
                            StrokeEndLineCap="Round"
                            Data="M 8,1 A 7,7 0 1 1 1.5,10.5"/>
                    </Grid>
                    <Button Width="26" Height="24" Padding="0" MinWidth="0" MinHeight="0"
                            Focusable="False"
                            ToolTip="{Binding LaunchToolTip}"
                            ToolTipService.ShowOnDisabled="True"
                            IsEnabled="{Binding CanLaunch}"
                            Click="LaunchProfile_Click">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Setter Property="Margin" Value="0"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding HasLaunchCommand}" Value="True">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding HasLaunchCommand}" Value="True"/>
                                <Condition Binding="{Binding IsBackingUp}" Value="True"/>
                              </MultiDataTrigger.Conditions>
                              <Setter Property="Margin" Value="4,0,0,0"/>
                            </MultiDataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                      <Path Width="9" Height="10" Stretch="Fill"
                            Data="M 0,0 L 0,10 L 8,5 Z"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Archives -->
      <DockPanel Grid.Column="2">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,8" Background="Transparent">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="{loc:Loc main.archives}" FontSize="16" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="0,0,10,0"
                     IsHitTestVisible="False"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
            <Border x:Name="BackupSplitHost"
                    Height="24"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    CornerRadius="3"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}"/>
                  <Setter Property="BorderBrush" Value="{DynamicResource BorderBrushKey}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding BackupUnconditional}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource BackupForceBackgroundBrush}"/>
                      <Setter Property="BorderBrush" Value="{DynamicResource BackupForceBorderBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasProfile}" Value="False">
                      <Setter Property="Opacity" Value="0.45"/>
                      <Setter Property="IsEnabled" Value="False"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="1"/>
                  <ColumnDefinition Width="22"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackupNowButton"
                        Grid.Column="0"
                        MinWidth="0" MinHeight="0"
                        Padding="8,0"
                        FontWeight="SemiBold"
                        Style="{StaticResource SplitPartButtonStyle}"
                        Click="BackupNow_Click">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="{loc:Loc main.backupNow}" VerticalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <Border Grid.Column="1" Background="{Binding BorderBrush, ElementName=BackupSplitHost}"/>
                <ToggleButton x:Name="BackupModeButton"
                              Grid.Column="2"
                              MinWidth="0" MinHeight="0"
                              Style="{StaticResource SplitDropButtonStyle}"
                              IsChecked="{Binding IsOpen, ElementName=BackupModePopup, Mode=TwoWay}"
                              ToolTip="{loc:Loc main.backupModeTip}">
                  <Path Data="M 0 0 L 4 4 L 8 0 Z"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}"
                        Width="8" Height="4"
                        Stretch="Fill"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>
                </ToggleButton>
              </Grid>
            </Border>
            <Popup x:Name="BackupModePopup"
                   PlacementTarget="{Binding ElementName=BackupSplitHost}"
                   Placement="Bottom"
                   VerticalOffset="2"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Slide">
              <Border MinWidth="{Binding ActualWidth, ElementName=BackupSplitHost}"
                      Background="{DynamicResource PanelBackgroundBrush}"
                      BorderBrush="{DynamicResource BorderBrushKey}"
                      BorderThickness="1"
                      Padding="2">
                <StackPanel>
                  <Button Style="{StaticResource MenuLikeButtonStyle}"
                          Click="BackupModeRules_Click"
                          ToolTip="{loc:Loc main.backupModeRulesTip}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="BackupModeRulesMark" Text="✓" Width="16" FontWeight="SemiBold"/>
                      <TextBlock Text="{loc:Loc main.backupModeRules}"/>
                    </StackPanel>
                  </Button>
                  <Button Style="{StaticResource MenuLikeButtonStyle}"
                          Click="BackupModeForce_Click"
                          ToolTip="{loc:Loc main.backupModeForceTip}">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="BackupModeForceMark" Text="" Width="16" FontWeight="SemiBold"/>
                      <TextBlock Text="{loc:Loc main.backupModeForce}"/>
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
            </Popup>
            <Button Height="24" Padding="8,0" MinWidth="0" MinHeight="0"
                    Click="Restore_Click" IsEnabled="{Binding HasArchive}"
                    ToolTip="{loc:Loc main.restore}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                           VerticalAlignment="Center" Margin="0,0,6,0"/>
                <TextBlock Text="{loc:Loc main.restore}" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>
          <ProgressBar Grid.Column="2" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                       Minimum="0" Maximum="100"
                       Value="{Binding BackupProgressPercent, Mode=OneWay}"
                       ToolTip="{Binding BackupProgressTip, Mode=OneWay}">
            <ProgressBar.Style>
              <Style TargetType="ProgressBar">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsBackupProgressVisible}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </ProgressBar.Style>
          </ProgressBar>
          <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Width="28" Height="24" Padding="0" MinWidth="0" MinHeight="0"
                    VerticalAlignment="Center"
                    Click="ArchivesFiltersToggle_Click"
                    ToolTip="{loc:Loc archive.filtersToggleTip}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ArchivesFiltersVisible}" Value="True">
                      <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <!-- When History is collapsed: chrome sits here, one button-gap after Filters. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <StackPanel.Style>
                <Style TargetType="StackPanel">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HistoryVisible}" Value="False">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </StackPanel.Style>
              <Button Width="28" Height="24" Padding="0" MinWidth="0" MinHeight="0"
                      Margin="14,0,14,0"
                      Click="HistoryVisibleToggle_Click"
                      ToolTip="{loc:Loc main.historyToggleTip}">
                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Button>
              <Button Width="28" Height="24" Padding="0" MinWidth="0" MinHeight="0"
                      Margin="0,0,4,0" Click="ThemeToggle_Click"
                      ToolTip="{loc:Loc main.themeTooltip}">
                <TextBlock x:Name="ThemeToggleIconCollapsed" Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Button>
              <Button Width="28" Height="24" Padding="0" MinWidth="0" MinHeight="0"
                      Click="OpenSettings_Click"
                      ToolTip="{loc:Loc main.settingsTooltip}">
                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Button>
            </StackPanel>
          </StackPanel>
        </Grid>
        <Border DockPanel.Dock="Top" Margin="0,0,0,8" Padding="8,6"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding ArchivesFiltersVisible}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <Grid Grid.IsSharedSizeScope="True">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc archive.filterName}"
                       VerticalAlignment="Center" Margin="0,0,8,4"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <TextBox Grid.Row="0" Grid.Column="1"
                     Height="24" Margin="0,0,10,4" Padding="4,2"
                     VerticalContentAlignment="Center"
                     Text="{Binding ArchiveFilterName, UpdateSourceTrigger=PropertyChanged}"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Loc archive.filterHasCustomName}"
                       VerticalAlignment="Center" Margin="0,0,6,4"
                       HorizontalAlignment="Right"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <Border Grid.Row="0" Grid.Column="3" Height="24" Margin="0,0,0,4"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1"
                    CornerRadius="3" SnapsToDevicePixels="True">
              <StackPanel Orientation="Horizontal">
                <RadioButton GroupName="ArchiveFilterCustomName"
                             Style="{StaticResource SegmentRadioStyle}"
                             Content="{loc:Loc archive.filterAny}"
                             IsChecked="{Binding ArchiveFilterHasCustomNameIsAny, Mode=TwoWay}"/>
                <Border Width="1" Background="{DynamicResource BorderBrushKey}"/>
                <RadioButton GroupName="ArchiveFilterCustomName"
                             Style="{StaticResource SegmentRadioStyle}"
                             Content="{loc:Loc archive.filterYes}"
                             IsChecked="{Binding ArchiveFilterHasCustomNameIsYes, Mode=TwoWay}"/>
                <Border Width="1" Background="{DynamicResource BorderBrushKey}"/>
                <RadioButton GroupName="ArchiveFilterCustomName"
                             Style="{StaticResource SegmentRadioStyle}"
                             Content="{loc:Loc archive.filterNo}"
                             IsChecked="{Binding ArchiveFilterHasCustomNameIsNo, Mode=TwoWay}"/>
              </StackPanel>
            </Border>
            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc archive.filterPeriod}"
                       VerticalAlignment="Center" Margin="0,0,8,4"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ArchiveFilterFromLabel"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ArchiveFilterToLabel"/>
                <ColumnDefinition Width="100"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{loc:Loc archive.filterPeriodFrom}"
                         VerticalAlignment="Center" Margin="0,0,6,0"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
              <DatePicker Grid.Column="1" Height="24" MinHeight="24"
                          VerticalContentAlignment="Center"
                          HorizontalAlignment="Stretch"
                          SelectedDate="{Binding ArchiveFilterDateFrom}"/>
              <TextBlock Grid.Column="3" Text="{loc:Loc archive.filterPeriodTo}"
                         VerticalAlignment="Center" Margin="0,0,6,0"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
              <DatePicker Grid.Column="4" Height="24" MinHeight="24"
                          VerticalContentAlignment="Center"
                          HorizontalAlignment="Stretch"
                          SelectedDate="{Binding ArchiveFilterDateTo}"/>
            </Grid>
            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc archive.filterSize}"
                       VerticalAlignment="Center" Margin="0,0,8,4"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ArchiveFilterFromLabel"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="Auto" SharedSizeGroup="ArchiveFilterToLabel"/>
                <ColumnDefinition Width="100"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Text="{loc:Loc archive.filterPeriodFrom}"
                         VerticalAlignment="Center" Margin="0,0,6,0"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
              <ComboBox Grid.Column="1" Height="24" Padding="4,2"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding ArchiveSizeFromOptions}"
                        SelectedItem="{Binding ArchiveFilterSizeFrom}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Grid.Column="3" Text="{loc:Loc archive.filterPeriodTo}"
                         VerticalAlignment="Center" Margin="0,0,6,0"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
              <ComboBox Grid.Column="4" Height="24" Padding="4,2"
                        HorizontalAlignment="Stretch"
                        ItemsSource="{Binding ArchiveSizeToOptions}"
                        SelectedItem="{Binding ArchiveFilterSizeTo}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Label}"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc archive.filterKeepForever}"
                       VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource SecondaryTextBrush}"/>
            <Border Grid.Row="3" Grid.Column="1" Height="24"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1"
                    CornerRadius="3" SnapsToDevicePixels="True">
              <StackPanel Orientation="Horizontal">
                <RadioButton GroupName="ArchiveFilterKeepForever"
                             Style="{StaticResource SegmentRadioStyle}"
                             Content="{loc:Loc archive.filterAny}"
                             IsChecked="{Binding ArchiveFilterKeepForeverIsAny, Mode=TwoWay}"/>
                <Border Width="1" Background="{DynamicResource BorderBrushKey}"/>
                <RadioButton GroupName="ArchiveFilterKeepForever"
                             Style="{StaticResource SegmentRadioStyle}"
                             Content="{loc:Loc archive.filterYes}"
                             IsChecked="{Binding ArchiveFilterKeepForeverIsYes, Mode=TwoWay}"/>
                <Border Width="1" Background="{DynamicResource BorderBrushKey}"/>
                <RadioButton GroupName="ArchiveFilterKeepForever"
                             Style="{StaticResource SegmentRadioStyle}"
                             Content="{loc:Loc archive.filterNo}"
                             IsChecked="{Binding ArchiveFilterKeepForeverIsNo, Mode=TwoWay}"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>
        <Grid DockPanel.Dock="Top" Margin="4,0,4,4">
          <Grid.Style>
            <Style TargetType="Grid">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding ArchivesFiltersVisible}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Grid.Style>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="38"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="152"/>
            <ColumnDefinition Width="62"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="#" FontSize="11" FontWeight="SemiBold"
                     HorizontalAlignment="Right" Margin="0,0,8,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
          <TextBlock Grid.Column="1" Text="{loc:Loc archive.displayName}" FontSize="11" FontWeight="SemiBold"
                     Margin="10,0,0,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
          <TextBlock Grid.Column="2" Text="{loc:Loc archive.date}" FontSize="11" FontWeight="SemiBold"
                     Margin="8,0,0,0" Foreground="{DynamicResource SecondaryTextBrush}"/>
          <TextBlock Grid.Column="3" Text="{loc:Loc archive.size}" FontSize="11" FontWeight="SemiBold"
                     HorizontalAlignment="Center" Margin="-20,0,0,0"
                     Foreground="{DynamicResource SecondaryTextBrush}"/>
        </Grid>
        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10,8"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1"
                Height="220"
                CacheMode="BitmapCache">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasArchive}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <!-- Bind via SelectedArchive.* — do not swap Grid.DataContext (causes full rebind flash). -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc archive.displayName}"
                         VerticalAlignment="Center" Margin="0,0,10,4"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBox x:Name="ArchiveDisplayNameBox"
                       Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Padding="4,2"
                       Text="{Binding SelectedArchive.DisplayName, UpdateSourceTrigger=PropertyChanged}"
                       GotFocus="ArchiveDisplayName_GotFocus"
                       LostFocus="ArchiveDisplayName_LostFocus"
                       KeyDown="ArchiveDisplayName_KeyDown"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc archive.fileName}"
                         VerticalAlignment="Center" Margin="0,0,10,4"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedArchive.Name}"
                         TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                         ToolTip="{Binding SelectedArchive.Name}"/>
              <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc archive.date}"
                         VerticalAlignment="Center" Margin="0,0,10,4"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                         Text="{Binding SelectedArchive.LastWriteTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
              <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc archive.size}"
                         VerticalAlignment="Center" Margin="0,0,10,4"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedArchive.SizeDisplay}" Margin="0,0,0,4"/>
              <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc archive.path}"
                         VerticalAlignment="Center" Margin="0,0,10,4"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedArchive.Path}"
                         TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                         ToolTip="{Binding SelectedArchive.Path}"/>
              <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc archive.format}"
                         VerticalAlignment="Center" Margin="0,0,10,4"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedArchive.FormatDisplay}" Margin="0,0,0,4"/>
              <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Loc archive.created}"
                         VerticalAlignment="Center" Margin="0,0,10,4"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedArchive.CreatedDisplay}" Margin="0,0,0,4"/>
              <TextBlock Grid.Row="7" Grid.Column="0" Text="{loc:Loc archive.profile}"
                         VerticalAlignment="Center" Margin="0,0,10,4"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding SelectedArchive.ManifestProfileName}"
                         TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>
              <TextBlock Grid.Row="8" Grid.Column="0" Text="{loc:Loc archive.keepForever}"
                         VerticalAlignment="Center" Margin="0,2,10,0"
                         TextWrapping="Wrap" MaxWidth="120"
                         Foreground="{DynamicResource SecondaryTextBrush}"
                         ToolTip="{loc:Loc archive.keepForeverTip}"/>
              <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal"
                          VerticalAlignment="Center" Margin="0,2,0,0"
                          ToolTip="{loc:Loc archive.keepForeverTip}">
                <ToggleButton Style="{StaticResource SwitchToggleStyle}"
                              IsChecked="{Binding SelectedArchive.ExcludeFromRetention, Mode=TwoWay}"
                              Click="ArchiveKeepForever_Click"
                              ToolTip="{loc:Loc archive.keepForeverTip}"/>
              </StackPanel>
            </Grid>
          </ScrollViewer>
        </Border>
         <ListBox x:Name="ArchivesList"
                  ItemsSource="{Binding Archives}" SelectedItem="{Binding SelectedArchive}"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  HorizontalContentAlignment="Stretch"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  SelectionChanged="ArchivesList_SelectionChanged"
                  MouseDoubleClick="ArchivesList_MouseDoubleClick"
                  PreviewMouseRightButtonDown="ArchivesList_PreviewMouseRightButtonDown">
          <ListBox.ContextMenu>
            <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem Header="{loc:Loc main.restore}" Click="Restore_Click"
                        IsEnabled="{Binding HasArchive}"/>
              <MenuItem Header="{loc:Loc main.revealInExplorer}" Click="ArchiveRevealInExplorer_Click"
                        IsEnabled="{Binding HasArchive}"/>
              <Separator/>
              <MenuItem Header="{loc:Loc main.delete}" Click="ArchiveDelete_Click"
                        IsEnabled="{Binding HasArchive}"/>
            </ContextMenu>
          </ListBox.ContextMenu>
           <ListBox.ItemTemplate>
             <DataTemplate>
               <Border BorderThickness="3,0,0,0" Padding="0,1,0,1" Margin="0,1">
                 <Border.Style>
                   <Style TargetType="Border">
                     <Setter Property="BorderBrush" Value="Transparent"/>
                     <Setter Property="Background" Value="Transparent"/>
                     <Style.Triggers>
                       <DataTrigger Binding="{Binding IsVeryFresh}" Value="True">
                         <Setter Property="BorderBrush" Value="{DynamicResource ArchiveAgeFreshBrush}"/>
                         <Setter Property="Background" Value="{DynamicResource ProcessRunningBackgroundBrush}"/>
                       </DataTrigger>
                     </Style.Triggers>
                   </Style>
                 </Border.Style>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="38"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="152"/>
                      <ColumnDefinition Width="62"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding RowNumber}"
                               VerticalAlignment="Center" HorizontalAlignment="Right"
                               Margin="0,0,8,0">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                          <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsVeryFresh}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource ArchiveAgeFreshBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasCustomDisplayName}" Value="True">
                              <Setter Property="Foreground" Value="{DynamicResource ArchiveNamedNumberBrush}"/>
                              <Setter Property="FontWeight" Value="Bold"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <Grid Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding ListTitle}" TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" ToolTip="{Binding Name}"
                                 PreviewMouseLeftButtonDown="ArchiveListTitle_PreviewMouseLeftButtonDown">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsEditingDisplayName}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsVeryFresh}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource ArchiveAgeFreshBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}"
                               Style="{StaticResource ArchiveListTitleBoxStyle}"
                               ToolTip="{Binding Name}"
                               IsVisibleChanged="ArchiveListDisplayName_IsVisibleChanged"
                               GotFocus="ArchiveListDisplayName_GotFocus"
                               LostFocus="ArchiveDisplayName_LostFocus"
                               KeyDown="ArchiveDisplayName_KeyDown"/>
                    </Grid>
                   <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0,0,0"
                               VerticalAlignment="Center">
                     <TextBlock Text="{Binding LastWriteTime, StringFormat={}{0:yyyy-MM-dd}}">
                       <TextBlock.Style>
                         <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                           <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                           <Style.Triggers>
                             <DataTrigger Binding="{Binding IsVeryFresh}" Value="True">
                               <Setter Property="Foreground" Value="{DynamicResource ArchiveAgeFreshBrush}"/>
                             </DataTrigger>
                           </Style.Triggers>
                         </Style>
                       </TextBlock.Style>
                     </TextBlock>
                     <Ellipse Width="6" Height="6" Margin="5,0,5,0"
                              VerticalAlignment="Center"
                              Fill="{Binding AgeDotBrush}"
                              SnapsToDevicePixels="True"/>
                     <TextBlock Text="{Binding LastWriteTime, StringFormat={}{0:HH:mm}}">
                       <TextBlock.Style>
                         <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                           <Style.Triggers>
                             <DataTrigger Binding="{Binding IsVeryFresh}" Value="True">
                               <Setter Property="Foreground" Value="{DynamicResource ArchiveAgeFreshBrush}"/>
                             </DataTrigger>
                           </Style.Triggers>
                         </Style>
                       </TextBlock.Style>
                     </TextBlock>
                   </StackPanel>
                   <TextBlock Grid.Column="3" Text="{Binding SizeDisplay}"
                              VerticalAlignment="Center" HorizontalAlignment="Right">
                     <TextBlock.Style>
                       <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                         <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
                         <Style.Triggers>
                           <DataTrigger Binding="{Binding IsVeryFresh}" Value="True">
                             <Setter Property="Foreground" Value="{DynamicResource ArchiveAgeFreshBrush}"/>
                           </DataTrigger>
                         </Style.Triggers>
                       </Style>
                     </TextBlock.Style>
                   </TextBlock>
                 </Grid>
               </Border>
             </DataTemplate>
           </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- History -->
      <DockPanel Grid.Column="4">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HistoryVisible}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <Button Width="28" Height="24" Padding="0" MinWidth="0" MinHeight="0"
                    Margin="0,0,14,0"
                    Click="HistoryVisibleToggle_Click"
                    ToolTip="{loc:Loc main.historyToggleTip}">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}"/>
                </Style>
              </Button.Style>
              <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <Button x:Name="ThemeToggleButton" Width="28" Height="24" Padding="0" MinWidth="0" MinHeight="0"
                    Margin="0,0,4,0" Click="ThemeToggle_Click"
                    ToolTip="{loc:Loc main.themeTooltip}">
              <TextBlock x:Name="ThemeToggleIcon" Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
            <Button Width="28" Height="24" Padding="0" MinWidth="0" MinHeight="0"
                    Click="OpenSettings_Click"
                    ToolTip="{loc:Loc main.settingsTooltip}">
              <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>
          </StackPanel>
          <DockPanel LastChildFill="True">
            <DockPanel.Style>
              <Style TargetType="DockPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HistoryVisible}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </DockPanel.Style>
            <Button DockPanel.Dock="Right" Margin="0,0,8,0" Padding="6,0" Height="22" FontSize="11"
                    Content="{loc:Loc main.clearHistoryFilter}"
                    Click="ClearHistoryFilter_Click"
                    ToolTip="{loc:Loc main.clearHistoryFilterTooltip}"
                    VerticalAlignment="Center">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasHistoryFilter}" Value="True">
                      <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
            </Button>
            <TextBlock Text="{loc:Loc main.history}" FontSize="16" FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
          </DockPanel>
        </DockPanel>
        <DockPanel LastChildFill="True">
          <DockPanel.Style>
            <Style TargetType="DockPanel">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding HistoryVisible}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </DockPanel.Style>
          <TextBlock DockPanel.Dock="Top" Text="{Binding HistoryFilterDisplay}" FontSize="11"
                     Foreground="{DynamicResource SecondaryTextBrush}"
                     TextTrimming="CharacterEllipsis" Margin="0,0,0,8"
                     ToolTip="{Binding HistoryFilterDisplay}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasHistoryFilter}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <ListBox x:Name="HistoryList"
                   ItemsSource="{Binding History}"
                   SelectionChanged="HistoryList_SelectionChanged"
                   MouseDoubleClick="HistoryList_MouseDoubleClick"
                   PreviewMouseRightButtonDown="HistoryList_PreviewMouseRightButtonDown">
            <ListBox.ContextMenu>
              <ContextMenu Opened="HistoryContextMenu_Opened">
                <MenuItem Tag="restore" Header="{loc:Loc main.restore}"
                          Click="HistoryRestore_Click"/>
                <MenuItem Tag="delete" Header="{loc:Loc main.delete}"
                          Click="HistoryDelete_Click"/>
                <Separator/>
                <MenuItem Tag="clear" Header="{loc:Loc history.clear}"
                          Click="HistoryClear_Click"/>
              </ContextMenu>
            </ListBox.ContextMenu>
            <ListBox.Resources>
              <DataTemplate DataType="{x:Type models:RunHistoryEntry}">
                <StackPanel Margin="0,2">
                  <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Text" Value="FAIL"/>
                          <Setter Property="Foreground" Value="{DynamicResource FailBrush}"/>
                          <Style.Triggers>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Success}" Value="True"/>
                                <Condition Binding="{Binding Skipped}" Value="False"/>
                              </MultiDataTrigger.Conditions>
                              <Setter Property="Text" Value="OK"/>
                              <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                            </MultiDataTrigger>
                            <DataTrigger Binding="{Binding Skipped}" Value="True">
                              <Setter Property="Text" Value="SKIP"/>
                              <Setter Property="Foreground" Value="{DynamicResource SkipBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                    <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Margin="8,0"
                             VerticalAlignment="Center">
                      <Ellipse.Style>
                        <Style TargetType="Ellipse">
                          <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}"/>
                          <Style.Triggers>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Success}" Value="True"/>
                                <Condition Binding="{Binding Skipped}" Value="False"/>
                              </MultiDataTrigger.Conditions>
                              <Setter Property="Fill" Value="{DynamicResource OkBrush}"/>
                            </MultiDataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Style.Triggers>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Success}" Value="True"/>
                                <Condition Binding="{Binding Skipped}" Value="False"/>
                              </MultiDataTrigger.Conditions>
                              <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                            </MultiDataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </DockPanel>
                  <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0} - {1:yyyy-MM-dd HH:mm}">
                        <Binding Path="Trigger"/>
                        <Binding Path="StartedUtc.LocalDateTime"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11"/>
                </StackPanel>
              </DataTemplate>
              <DataTemplate DataType="{x:Type vm:HistoryLoadMoreItem}">
                <Button Margin="0,8,0,4" Padding="8,6" HorizontalAlignment="Stretch"
                        Content="{Binding Caption}"
                        Click="LoadAllHistory_Click"
                        ToolTip="{loc:Loc history.loadAllTooltip}"/>
              </DataTemplate>
            </ListBox.Resources>
          </ListBox>
        </DockPanel>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
