<Window x:Class="WpfApp_BackupSaves.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WpfApp_BackupSaves.Controls"
        Title="BackupSaves" Height="740" Width="1080"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
  <DockPanel>
    <controls:CustomTitleBar DockPanel.Dock="Top"/>

    <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource StatusBarBackgroundBrush}">
      <StatusBar.ItemsPanel>
        <ItemsPanelTemplate>
          <DockPanel LastChildFill="True"/>
        </ItemsPanelTemplate>
      </StatusBar.ItemsPanel>
      <StatusBarItem DockPanel.Dock="Right">
        <StackPanel Orientation="Horizontal">
          <Button Content="Логи" Padding="10,2" Margin="0,0,8,0"
                  Click="OpenLogs_Click" ToolTip="Открыть папку логов"/>
          <Button x:Name="ThemeToggleButton" Content="☀ Светлая" Padding="10,2" Margin="0,0,8,0"
                  Click="ThemeToggle_Click" ToolTip="Переключить тему"/>
        </StackPanel>
      </StatusBarItem>
      <StatusBarItem>
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource PrimaryTextBrush}"/>
      </StatusBarItem>
    </StatusBar>

    <Grid Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="255"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="255"/>
      </Grid.ColumnDefinitions>

      <!-- Profiles -->
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Профили" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="Добавить" Width="84" Height="30" Margin="0,0,6,0" Click="AddProfile_Click" IsEnabled="{Binding CanInteract}"/>
          <Button Content="Изменить" Width="84" Height="30" Margin="0,0,6,0" Click="EditProfile_Click" IsEnabled="{Binding HasProfile}"/>
          <Button Content="Удалить" Width="84" Height="30" Click="DeleteProfile_Click" IsEnabled="{Binding HasProfile}"/>
        </StackPanel>
        <ListBox ItemsSource="{Binding Profiles}"
                 SelectedItem="{Binding SelectedProfile}"
                 DisplayMemberPath="Name"
                 SelectionChanged="Profiles_SelectionChanged"/>
      </DockPanel>

      <!-- Archives -->
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="Архивы" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="Бэкап сейчас" Width="120" Height="32" Margin="0,0,8,0"
                  Click="BackupNow_Click" IsEnabled="{Binding HasProfile}" FontWeight="SemiBold"/>
          <Button Content="Восстановить" Width="120" Height="32" Margin="0,0,8,0"
                  Click="Restore_Click" IsEnabled="{Binding HasArchive}"/>
          <Button Content="Открыть папку" Width="110" Height="32"
                  Click="OpenFolder_Click" IsEnabled="{Binding HasProfile}"/>
        </StackPanel>
        <ListBox x:Name="ArchivesList"
                 ItemsSource="{Binding Archives}" SelectedItem="{Binding SelectedArchive}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 PreviewMouseRightButtonDown="ArchivesList_PreviewMouseRightButtonDown">
          <ListBox.ContextMenu>
            <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem Header="Восстановить" Click="Restore_Click"
                        IsEnabled="{Binding HasArchive}"/>
              <MenuItem Header="Открыть в проводнике" Click="ArchiveRevealInExplorer_Click"
                        IsEnabled="{Binding HasArchive}"/>
              <Separator/>
              <MenuItem Header="Удалить" Click="ArchiveDelete_Click"
                        IsEnabled="{Binding HasArchive}"/>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="72"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding LastWriteTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- History -->
      <DockPanel Grid.Column="4">
        <TextBlock DockPanel.Dock="Top" Text="История" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ListBox ItemsSource="{Binding History}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,2">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="FAIL"/>
                        <Setter Property="Foreground" Value="{DynamicResource FailBrush}"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Success}" Value="True">
                            <Setter Property="Text" Value="OK"/>
                            <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Margin="8,0"
                           VerticalAlignment="Center"
                           Fill="{DynamicResource SecondaryTextBrush}"/>
                  <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} - {1:yyyy-MM-dd HH:mm}">
                      <Binding Path="Trigger"/>
                      <Binding Path="StartedUtc.LocalDateTime"/>
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
