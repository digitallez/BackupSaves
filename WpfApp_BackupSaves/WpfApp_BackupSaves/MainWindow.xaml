<Window x:Class="WpfApp_BackupSaves.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WpfApp_BackupSaves.Controls"
        Title="BackupSaves" Height="640" Width="980"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
  <DockPanel>
    <controls:CustomTitleBar DockPanel.Dock="Top"/>

    <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource StatusBarBackgroundBrush}">
      <StatusBar.ItemsPanel>
        <ItemsPanelTemplate>
          <DockPanel LastChildFill="True"/>
        </ItemsPanelTemplate>
      </StatusBar.ItemsPanel>
      <StatusBarItem DockPanel.Dock="Right">
        <Button x:Name="ThemeToggleButton" Content="☀ Светлая" Padding="10,2" Margin="8,0"
                Click="ThemeToggle_Click" ToolTip="Переключить тему"/>
      </StatusBarItem>
      <StatusBarItem>
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource PrimaryTextBrush}"/>
      </StatusBarItem>
    </StatusBar>

    <Grid Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="280"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="280"/>
      </Grid.ColumnDefinitions>

      <!-- Profiles -->
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="Профили" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="Добавить" Width="84" Height="30" Margin="0,0,6,0" Click="AddProfile_Click" IsEnabled="{Binding CanInteract}"/>
          <Button Content="Изменить" Width="84" Height="30" Margin="0,0,6,0" Click="EditProfile_Click" IsEnabled="{Binding HasProfile}"/>
          <Button Content="Удалить" Width="84" Height="30" Click="DeleteProfile_Click" IsEnabled="{Binding HasProfile}"/>
        </StackPanel>
        <ListBox ItemsSource="{Binding Profiles}"
                 SelectedItem="{Binding SelectedProfile}"
                 DisplayMemberPath="Name"
                 SelectionChanged="Profiles_SelectionChanged"/>
      </DockPanel>

      <!-- Archives -->
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="Архивы" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="Бэкап сейчас" Width="120" Height="32" Margin="0,0,8,0"
                  Click="BackupNow_Click" IsEnabled="{Binding HasProfile}" FontWeight="SemiBold"/>
          <Button Content="Restore" Width="100" Height="32" Margin="0,0,8,0"
                  Click="Restore_Click" IsEnabled="{Binding HasArchive}"/>
          <Button Content="Открыть папку" Width="110" Height="32"
                  Click="OpenFolder_Click" IsEnabled="{Binding HasProfile}"/>
        </StackPanel>
        <ListView ItemsSource="{Binding Archives}" SelectedItem="{Binding SelectedArchive}">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Имя" Width="280" DisplayMemberBinding="{Binding Name}"/>
              <GridViewColumn Header="Дата" Width="140" DisplayMemberBinding="{Binding LastWriteTime}"/>
              <GridViewColumn Header="Размер" Width="80" DisplayMemberBinding="{Binding SizeDisplay}"/>
            </GridView>
          </ListView.View>
        </ListView>
      </DockPanel>

      <!-- History -->
      <DockPanel Grid.Column="4">
        <TextBlock DockPanel.Dock="Top" Text="История" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <ListBox ItemsSource="{Binding History}">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,2">
                <TextBlock FontWeight="SemiBold">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Text" Value="FAIL"/>
                      <Setter Property="Foreground" Value="{DynamicResource FailBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Success}" Value="True">
                          <Setter Property="Text" Value="OK"/>
                          <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Trigger}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Text="{Binding StartedUtc, StringFormat={}{0:g}}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"/>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11"/>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
