<Window x:Class="WpfApp_BackupSaves.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WpfApp_BackupSaves.Controls"
        xmlns:loc="clr-namespace:WpfApp_BackupSaves.Markup"
        xmlns:vm="clr-namespace:WpfApp_BackupSaves.ViewModels"
        xmlns:models="clr-namespace:BackupSaves.Core.Models;assembly=BackupSaves.Core"
        Title="BackupSaves" Height="740" Width="1080"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/app.ico"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
  <DockPanel>
    <controls:CustomTitleBar DockPanel.Dock="Top"/>

    <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource StatusBarBackgroundBrush}">
      <StatusBar.ItemsPanel>
        <ItemsPanelTemplate>
          <DockPanel LastChildFill="True"/>
        </ItemsPanelTemplate>
      </StatusBar.ItemsPanel>
      <StatusBarItem DockPanel.Dock="Right">
        <StackPanel Orientation="Horizontal">
          <Button Content="{loc:Loc main.logs}" Padding="10,2" Margin="0,0,8,0"
                  Click="OpenLogs_Click" ToolTip="{loc:Loc main.logsTooltip}"/>
          <Button x:Name="ThemeToggleButton" Content="{loc:Loc main.themeLight}" Padding="10,2" Margin="0,0,8,0"
                  Click="ThemeToggle_Click" ToolTip="{loc:Loc main.themeTooltip}"/>
        </StackPanel>
      </StatusBarItem>
      <StatusBarItem>
        <TextBlock Text="{Binding Status}" Foreground="{DynamicResource PrimaryTextBrush}"/>
      </StatusBarItem>
    </StatusBar>

    <Grid Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="255"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="255"/>
      </Grid.ColumnDefinitions>

      <!-- Profiles -->
      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc main.profiles}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="{loc:Loc main.add}" Width="84" Height="30" Margin="0,0,6,0" Click="AddProfile_Click" IsEnabled="{Binding CanInteract}"/>
          <Button Content="{loc:Loc main.edit}" Width="84" Height="30" Margin="0,0,6,0" Click="EditProfile_Click" IsEnabled="{Binding HasProfile}"/>
          <Button Content="{loc:Loc main.delete}" Width="84" Height="30" Click="DeleteProfile_Click" IsEnabled="{Binding HasProfile}"/>
        </StackPanel>
        <ListBox x:Name="ProfilesList"
                 ItemsSource="{Binding Profiles}"
                 SelectedItem="{Binding SelectedProfile}"
                 SelectionChanged="Profiles_SelectionChanged"
                 PreviewMouseRightButtonDown="ProfilesList_PreviewMouseRightButtonDown">
          <ListBox.ContextMenu>
            <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem Header="{loc:Loc main.add}" Click="AddProfile_Click"
                        IsEnabled="{Binding CanInteract}"/>
              <MenuItem Header="{loc:Loc main.edit}" Click="EditProfile_Click"
                        IsEnabled="{Binding HasProfile}"/>
              <MenuItem Header="{loc:Loc main.delete}" Click="DeleteProfile_Click"
                        IsEnabled="{Binding HasProfile}"/>
              <Separator/>
              <MenuItem Header="{loc:Loc main.filterHistory}" Click="FilterHistoryByProfile_Click"
                        IsEnabled="{Binding HasProfile}"/>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border BorderThickness="3,0,0,0" Padding="6,2,0,2">
                <Border.Style>
                  <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsWatchProcessRunning}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource ProcessRunningBrush}"/>
                        <Setter Property="Background" Value="{DynamicResource ProcessRunningBackgroundBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding NextBackupDisplay}" FontSize="11"
                             Foreground="{DynamicResource SecondaryTextBrush}"
                             TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasNextBackupDisplay}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- Archives -->
      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" Text="{loc:Loc main.archives}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
          <Button Content="{loc:Loc main.backupNow}" Width="120" Height="30" Margin="0,0,8,0"
                  Click="BackupNow_Click" IsEnabled="{Binding HasProfile}" FontWeight="SemiBold"/>
          <Button Content="{loc:Loc main.restore}" Width="120" Height="30" Margin="0,0,8,0"
                  Click="Restore_Click" IsEnabled="{Binding HasArchive}"/>
          <Button Content="{loc:Loc main.openFolder}" Width="110" Height="30"
                  Click="OpenFolder_Click" IsEnabled="{Binding HasProfile}"/>
        </StackPanel>
        <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10,8"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="1"
                Height="210">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasArchive}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid DataContext="{Binding SelectedArchive}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc archive.displayName}"
                         VerticalAlignment="Center" Margin="0,0,10,4"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBox x:Name="ArchiveDisplayNameBox"
                       Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Padding="4,2"
                       Text="{Binding DisplayName, UpdateSourceTrigger=Explicit}"
                       GotFocus="ArchiveDisplayName_GotFocus"
                       LostFocus="ArchiveDisplayName_LostFocus"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc archive.fileName}"
                         VerticalAlignment="Center" Margin="0,0,10,4"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Name}"
                         TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                         ToolTip="{Binding Name}"/>
              <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc archive.date}"
                         VerticalAlignment="Center" Margin="0,0,10,4"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                         Text="{Binding LastWriteTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"/>
              <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc archive.size}"
                         VerticalAlignment="Center" Margin="0,0,10,4"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SizeDisplay}" Margin="0,0,0,4"/>
              <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc archive.path}"
                         VerticalAlignment="Center" Margin="0,0,10,4"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Path}"
                         TextTrimming="CharacterEllipsis" Margin="0,0,0,4"
                         ToolTip="{Binding Path}"/>
              <TextBlock Grid.Row="5" Grid.Column="0" Text="{loc:Loc archive.format}"
                         VerticalAlignment="Center" Margin="0,0,10,4"
                         Foreground="{DynamicResource SecondaryTextBrush}"/>
              <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding FormatDisplay}" Margin="0,0,0,4"/>
              <TextBlock Grid.Row="6" Grid.Column="0" Text="{loc:Loc archive.created}"
                         VerticalAlignment="Center" Margin="0,0,10,4"
                         Foreground="{DynamicResource SecondaryTextBrush}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasCreatedDisplay}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding CreatedDisplay}" Margin="0,0,0,4">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasCreatedDisplay}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Grid.Row="7" Grid.Column="0" Text="{loc:Loc archive.profile}"
                         VerticalAlignment="Center" Margin="0,0,10,0"
                         Foreground="{DynamicResource SecondaryTextBrush}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasManifestProfileName}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
              <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ManifestProfileName}"
                         TextTrimming="CharacterEllipsis">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasManifestProfileName}" Value="True">
                        <Setter Property="Visibility" Value="Visible"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
          </ScrollViewer>
        </Border>
        <ListBox x:Name="ArchivesList"
                 ItemsSource="{Binding Archives}" SelectedItem="{Binding SelectedArchive}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 SelectionChanged="ArchivesList_SelectionChanged"
                 PreviewMouseRightButtonDown="ArchivesList_PreviewMouseRightButtonDown">
          <ListBox.ContextMenu>
            <ContextMenu DataContext="{Binding Path=PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
              <MenuItem Header="{loc:Loc main.restore}" Click="Restore_Click"
                        IsEnabled="{Binding HasArchive}"/>
              <MenuItem Header="{loc:Loc main.revealInExplorer}" Click="ArchiveRevealInExplorer_Click"
                        IsEnabled="{Binding HasArchive}"/>
              <Separator/>
              <MenuItem Header="{loc:Loc main.delete}" Click="ArchiveDelete_Click"
                        IsEnabled="{Binding HasArchive}"/>
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="140"/>
                  <ColumnDefinition Width="72"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding LastWriteTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}"
                           VerticalAlignment="Center" HorizontalAlignment="Right"
                           Foreground="{DynamicResource SecondaryTextBrush}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <!-- History -->
      <DockPanel Grid.Column="4">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
          <ComboBox DockPanel.Dock="Right"
                    MinWidth="110" Height="22" Padding="2,0" FontSize="11"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding Languages}"
                    SelectedItem="{Binding SelectedLanguage}"
                    ToolTip="{loc:Loc main.languageTooltip}">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            ToolTip="{Binding Code}">
                  <Image Width="16" Height="12"
                         Stretch="Uniform" VerticalAlignment="Center"
                         RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Style>
                      <Style TargetType="Image">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Setter Property="Source" Value="{x:Null}"/>
                        <Setter Property="Margin" Value="0"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding HasFlag}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="Source" Value="{Binding FlagUri}"/>
                            <Setter Property="Margin" Value="0,0,4,0"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Image.Style>
                  </Image>
                  <TextBlock Text="{Binding Display}"
                             VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <Button DockPanel.Dock="Right" Margin="0,0,8,0" Padding="6,0" Height="22" FontSize="11"
                  Content="{loc:Loc main.clearHistoryFilter}"
                  Click="ClearHistoryFilter_Click"
                  ToolTip="{loc:Loc main.clearHistoryFilterTooltip}"
                  VerticalAlignment="Center">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding HasHistoryFilter}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
          </Button>
          <TextBlock Text="{loc:Loc main.history}" FontSize="16" FontWeight="SemiBold"
                     VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding HistoryFilterDisplay}" FontSize="11"
                   Foreground="{DynamicResource SecondaryTextBrush}"
                   TextTrimming="CharacterEllipsis" Margin="0,0,0,8"
                   ToolTip="{Binding HistoryFilterDisplay}">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding HasHistoryFilter}" Value="True">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
        <Button DockPanel.Dock="Bottom" Content="{loc:Loc main.exit}" Height="30" Margin="0,8,0,0"
                Click="ForceExit_Click" ToolTip="{loc:Loc main.exitTooltip}"/>
        <ListBox x:Name="HistoryList"
                 ItemsSource="{Binding History}"
                 SelectionChanged="HistoryList_SelectionChanged">
          <ListBox.Resources>
            <DataTemplate DataType="{x:Type models:RunHistoryEntry}">
              <StackPanel Margin="0,2">
                <DockPanel LastChildFill="True">
                  <TextBlock DockPanel.Dock="Left" FontWeight="SemiBold" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Text" Value="FAIL"/>
                        <Setter Property="Foreground" Value="{DynamicResource FailBrush}"/>
                        <Style.Triggers>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding Success}" Value="True"/>
                              <Condition Binding="{Binding Skipped}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Text" Value="OK"/>
                            <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                          </MultiDataTrigger>
                          <DataTrigger Binding="{Binding Skipped}" Value="True">
                            <Setter Property="Text" Value="SKIP"/>
                            <Setter Property="Foreground" Value="{DynamicResource SkipBrush}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                  <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Margin="8,0"
                           VerticalAlignment="Center">
                    <Ellipse.Style>
                      <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}"/>
                        <Style.Triggers>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding Success}" Value="True"/>
                              <Condition Binding="{Binding Skipped}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Fill" Value="{DynamicResource OkBrush}"/>
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Ellipse.Style>
                  </Ellipse>
                  <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                              <Condition Binding="{Binding Success}" Value="True"/>
                              <Condition Binding="{Binding Skipped}" Value="False"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Foreground" Value="{DynamicResource OkBrush}"/>
                          </MultiDataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </DockPanel>
                <TextBlock FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}">
                  <TextBlock.Text>
                    <MultiBinding StringFormat="{}{0} - {1:yyyy-MM-dd HH:mm}">
                      <Binding Path="Trigger"/>
                      <Binding Path="StartedUtc.LocalDateTime"/>
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="11"/>
              </StackPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:HistoryLoadMoreItem}">
              <Button Margin="0,8,0,4" Padding="8,6" HorizontalAlignment="Stretch"
                      Content="{Binding Caption}"
                      Click="LoadAllHistory_Click"
                      ToolTip="{loc:Loc history.loadAllTooltip}"/>
            </DataTemplate>
          </ListBox.Resources>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
